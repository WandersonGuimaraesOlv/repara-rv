# .env.local — SÓ variáveis PÚBLICAS (NEXT_PUBLIC_*).
# O build do Next precisa delas pra montar o bundle do navegador.
#
# NUNCA coloque segredo neste arquivo: no deploy, o OpenNext copia o conteúdo
# de todo .env* pra dentro do código do Worker (.open-next/cloudflare/next-env.mjs).
# Segredos ficam em .dev.vars (local — veja .dev.vars.example) e nos secrets
# do Cloudflare (produção — `npx wrangler secret put NOME`).

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# URL pública do app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave pública do Web Push (mesma de VAPID_PUBLIC_KEY em .dev.vars)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
