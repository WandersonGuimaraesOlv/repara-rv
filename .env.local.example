NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Mercado Pago (Pix)
MERCADOPAGO_ACCESS_TOKEN=seu-access-token-aqui
MERCADOPAGO_WEBHOOK_SECRET=sua-webhook-secret-aqui

# URL pública do app (necessário para webhooks do Pix e cron interno)
NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_API_URL=https://repararv.com

# Web Push VAPID (PWA — Chrome/Safari)
# Gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@repararv.com

# Token secreto para rotas internas (cron e push/send)
# Gerar com: openssl rand -base64 32
CRON_SECRET_TOKEN=

# FCM — Firebase Cloud Messaging (Flutter Android/iOS)
# SOMENTE necessário ao lançar os apps Flutter nativos.
# Obter em: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Serializar o JSON como string: cat service-account.json | jq -c .
FIREBASE_SERVICE_ACCOUNT_JSON=

