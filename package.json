{
  "name": "repara-rv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:race:claim": "node --env-file=.env.local scripts/test-claim-race.mjs",
    "test:race:claim-fallback": "node --env-file=.env.local scripts/test-claim-fallback-race.mjs",
    "test:race:skip": "node --env-file=.env.local scripts/test-skip-provider-race.mjs",
    "test:idempotency:webhook": "node --env-file=.env.local scripts/test-webhook-idempotency.mjs",
    "test:realtime:reconnect": "node --env-file=.env.local scripts/test-realtime-reconnect.mjs",
    "test:rls": "node --env-file=.env.local scripts/test-rls-policies.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "types:db": "npx supabase gen types typescript --project-id lvjahufllclmkqcbbrcu > types/supabase.ts",
    "check:arch": "depcruise --config .dependency-cruiser.cjs app components lib modules",
    "check:types": "tsc --noEmit",
    "validate": "npm run check:types && npm run check:arch && npm run lint"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.1"
  }
}
