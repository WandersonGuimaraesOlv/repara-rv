{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Entrada própria: reexporta .open-next/worker.js e acrescenta o Cron Trigger (ver custom-worker.ts)
	"main": "custom-worker.ts",
	"name": "repara-rv",
	"account_id": "f9b77b85c77a156f6ec4f5f79fed3f0e",
	"compatibility_date": "2026-09-08",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "repara-rv"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// Radar de chamados parados na fila: 1x por minuto (o alerta usa janela de 1 tick, ver stale-queue-alert.ts)
	"triggers": {
		"crons": ["* * * * *"]
	},
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://lvjahufllclmkqcbbrcu.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable__Dm38pztWgjBHD5ZXmv4sQ_GOFOYwhz",
		"NEXT_PUBLIC_APP_URL": "https://repararv.com"
	}
}
