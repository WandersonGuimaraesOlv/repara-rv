# .dev.vars — SEGREDOS do ambiente local (não versionado, está no .gitignore).
# É lido pelo `next dev` (via initOpenNextCloudflareForDev), pelo `wrangler` e
# pelos scripts (`node --env-file=.env.local --env-file=.dev.vars ...`).
#
# Produção NÃO lê este arquivo: lá os mesmos nomes são secrets do Worker
#   npx wrangler secret put NOME     (ou `npx wrangler secret bulk`)
# Ao criar/girar um segredo, atualize os dois lugares.

SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Mercado Pago (Pix)
MERCADOPAGO_ACCESS_TOKEN=seu-access-token-aqui
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=sua-webhook-secret-aqui

# Web Push VAPID (PWA — Chrome/Safari)
# Gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@repararv.com

# Token secreto para rotas internas (cron e push/send)
# Gerar com: openssl rand -base64 32
CRON_SECRET_TOKEN=

# Alerta de fila parada (Cron Trigger de 1 min em custom-worker.ts): e-mail do time que
# recebe o aviso quando um chamado passa de 5 min sem prestador. Usa o RESEND_API_KEY.
# Em produção é secret do Worker (npx wrangler secret put OPS_ALERT_EMAIL).
OPS_ALERT_EMAIL=

# FCM — Firebase Cloud Messaging (Flutter Android/iOS)
# SOMENTE necessário ao lançar os apps Flutter nativos.
# Serializar o JSON como string: cat service-account.json | jq -c .
FIREBASE_SERVICE_ACCOUNT_JSON=

# Resend — envio de e-mail transacional (reset de PIN por e-mail)
# Obter em: resend.com > API Keys. Remetente: noreply@repararv.com (domínio verificado)
RESEND_API_KEY=

# Google Maps Platform — Geocoding API (transforma o endereço digitado em coordenadas,
# só no servidor). Restrinja a chave à Geocoding API e ponha um limite diário de
# consultas no console do Google. Em produção é secret do Worker
# (npx wrangler secret put GOOGLE_MAPS_API_KEY).
GOOGLE_MAPS_API_KEY=

# Só para rodar `npm run deploy` da sua máquina (o app NÃO usa em runtime):
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
